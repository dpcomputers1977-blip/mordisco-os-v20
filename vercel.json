{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/staff",
      "destination": "/staff.html"
    },
    {
      "source": "/comandas",
      "destination": "/comandas.html"
    },
    {
      "source": "/pedir",
      "destination": "/pedir.html"
    },
    {
      "source": "/app",
      "destination": "/pedir.html"
    },
    {
      "source": "/promociones",
      "destination": "/promociones.html"
    },
    {
      "source": "/pagina/:slug",
      "destination": "/page.html"
    },
    {
      "source": "/recompensas",
      "destination": "/recompensas.html"
    },
    {
      "source": "/juegos",
      "destination": "/juegos/index.html"
    },
    {
      "source": "/juegos/mordisco-rush",
      "destination": "/juegos/mordisco-rush.html"
    },
    {
      "source": "/juegos/mordisco-party",
      "destination": "/juegos/mordisco-party.html"
    },
    {
      "source": "/juegos/mordisco-maze",
      "destination": "/juegos/mordisco-maze.html"
    },
    {
      "source": "/juegos/mordisco-kitchen-rush",
      "destination": "/juegos/mordisco-kitchen-rush.html"
    },
    {
      "source": "/juegos/mordisco-memory-battle",
      "destination": "/juegos/mordisco-memory-battle.html"
    },
    {
      "source": "/juegos/mordisco-burger-tower",
      "destination": "/juegos/mordisco-burger-tower.html"
    },
    {
      "source": "/juegos/mordisco-catch",
      "destination": "/juegos/mordisco-catch.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
