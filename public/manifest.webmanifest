{
  "name": "Mordisco Fast Food",
  "short_name": "Mordisco",
  "description": "Menú, promociones, horarios y pedidos en línea de Mordisco Fast Food.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#0d0d0d",
  "theme_color": "#ff7a00",
  "orientation": "portrait-primary",
  "categories": [
    "food",
    "shopping",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pedir ahora",
      "short_name": "Pedir",
      "description": "Abrir pedidos en línea",
      "url": "/pedir",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Promociones",
      "short_name": "Promos",
      "description": "Ver promociones activas",
      "url": "/promociones",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Horarios",
      "short_name": "Horarios",
      "description": "Consultar horarios de atención",
      "url": "/#horarios",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
